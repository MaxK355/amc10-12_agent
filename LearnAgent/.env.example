# Copy to .env and fill in. The .env file is gitignored.
# One of these two options picks the model backend:

# Option A: Alibaba DashScope (Qwen) via its OpenAI-compatible endpoint
DASHSCOPE_API_KEY=sk-...

# Option B: any other OpenAI-compatible endpoint
# TUTOR_BASE_URL=https://api.example.com/v1
# TUTOR_API_KEY=sk-...

# Optional: model name (required with a custom provider; defaults to qwen-max for DashScope)
# TUTOR_MODEL=qwen-plus
